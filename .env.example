# Local/native operational settings. Source credentials are read only by the
# backend auto-login flow when explicitly enabled; they are never returned to
# the browser or logged.
PORT=8787
# Published Compose app port; direct access is http://host:${APP_PORT}.
APP_PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
# Required by Docker Compose. Set your PostgreSQL URL in the untracked .env file or server secrets.
DATABASE_URL=
SYNC_INTERVAL_MINUTES=1440
HOUSEKEEPING_ENABLED=true
# Cleanup runs every 6 hours when no sync job is active or queued.
HOUSEKEEPING_INTERVAL_MINUTES=360
HOUSEKEEPING_SNAPSHOT_RETAIN=3
HOUSEKEEPING_JOB_RETENTION_DAYS=90
HOUSEKEEPING_CACHE_ENABLED=true
TRUST_PROXY=0
COOKIE_SECURE=0
# When nginx terminates HTTPS, set TRUST_PROXY=1, COOKIE_SECURE=1, and use the
# exact public URL (scheme + host + optional port) here.
PUBLIC_ORIGIN=

# Optional 24h source auto-login. Keep real values in an untracked .env file
# or a server secret store; `false` keeps manual sessions.
SOURCE_24H_USERNAME=
SOURCE_24H_PASSWORD=
SOURCE_24H_AUTO_LOGIN=false
# Explicit opt-in for the provider's HTTP redirect/form. Keep false unless
# the source is known to require HTTP and the network is trusted.
SOURCE_24H_ALLOW_INSECURE_HTTP=false

# Optional Admicro PC/Mobile source auto-login. Keep real values in an
# untracked .env file or a server secret store; false keeps manual sessions.
SOURCE_ADMICRO_USERNAME=
SOURCE_ADMICRO_PASSWORD=
SOURCE_ADMICRO_AUTO_LOGIN=false

# Google Ads monthly source. Keep real values in an untracked .env file or a
# server secret store; the app never returns or logs these values.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Optional for managed access configurations; leave blank when the provider
# authorizes the customer without a developer token.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta Ads report import. Store real secrets only in an untracked .env file or
# server secret store; Ads Manager URLs never supply access tokens.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v26.0

# Optional Compose identity placeholders; set these to the unprivileged server UID/GID.
APP_UID=1000
APP_GID=1000
